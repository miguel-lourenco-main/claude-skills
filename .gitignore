# claude-skills monorepo — gitignore

# Externally version-managed skills (updated by their own installers; not ours to track)
graphify/

# Node
node_modules/
**/node_modules/

# Pipeline scratch
**/research/candidates.*.json

# Gallery deploy output (CI copies gallery/src -> public)
/public/

# Reference vault is LOCAL-ONLY — never committed. The hosted gallery loads a
# vault per-user (folder picker); locally it fetches from this dir directly.
ui-ux-references/vault/

# Secrets — never commit (e.g. PROSPECTOR_WORKER_TOKEN for the prospect-worker skill)
.env
.env.*
!.env.example

# Misc
*.log
.DS_Store
__pycache__/

# Per-machine API keys for plugins (model-router, context-checkpoint). Never committed:
# a marketplace checkout is a git repo, and an untracked key file is one `git add -A` from
# being published to every workstation that pulls it.
*.env
!*.env.example
