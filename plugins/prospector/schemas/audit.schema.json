{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prospector/audit",
  "title": "Website audit",
  "description": "Website capture + quality, keyed by company id. Separate from the company dossier so quality never pollutes identity/financials.",
  "type": "object",
  "required": ["companyId", "reachable"],
  "properties": {
    "companyId": { "type": "string" },
    "url": { "type": ["string", "null"] },
    "capturedAt": { "type": "string" },
    "reachable": { "type": "boolean", "description": "Did the site resolve + respond OK? Gate: a false here means NO capture and taste:null (never fabricated)." },
    "reason": { "type": ["string", "null"], "description": "Why unreachable: 'no website' | 'timeout' | 'unreachable' | 'http <code>'." },
    "status": { "type": ["number", "null"] },
    "captureError": { "type": ["string", "null"] },
    "tech": {
      "type": "object",
      "description": "Cheap, predictive signals — no vision needed.",
      "properties": {
        "https": { "type": "boolean" }, "mobileFriendly": { "type": "boolean" },
        "lighthousePerf": { "type": "number" }, "cms": { "type": "string" },
        "lastModified": { "type": "string" }, "domainAge": { "type": "number" },
        "htmlKB": { "type": "number" }, "loadMs": { "type": "number" },
        "title": { "type": ["string", "null"] }, "metaDescription": { "type": "boolean" },
        "ogTags": { "type": "boolean" }, "structuredData": { "type": "boolean" }, "analytics": { "type": "boolean" },
        "jsLibs": { "type": "array", "items": { "type": "string" }, "description": "Frameworks/libraries detected at runtime during capture." },
        "consoleErrors": { "type": "array", "items": { "type": "string" }, "description": "First console/page errors observed during capture (measured, max 10)." },
        "failedRequests": { "type": "array", "items": { "type": "string" }, "description": "Failed/4xx+ requests observed during capture (measured, max 10)." },
        "requestCount": { "type": "number" }, "pageBytes": { "type": "number", "description": "Best-effort transfer weight (content-length sum) — undercounts." }
      }
    },
    "screenshots": {
      "type": "object",
      "properties": {
        "desktop": { "type": "array", "items": { "type": "string" } },
        "mobile": { "type": "array", "items": { "type": "string" } },
        "thumbnail": { "type": ["string", "null"] }
      }
    },
    "taste": {
      "description": "null when the site couldn't be graded (no website / unreachable / capture failed); { pending:true } after capture, awaiting the agent's vision grading; the full object once graded. NEVER fabricated.",
      "oneOf": [
        { "type": "null" },
        { "type": "object", "required": ["pending"], "properties": { "pending": { "const": true } } },
        { "type": "object", "$ref": "#/$defs/tasteGraded" }
      ]
    }
  },
  "$defs": {
    "tasteGraded": {
      "type": "object",
      "required": ["scores", "overall", "opportunity"],
      "properties": {
        "scores": {
          "type": "object",
          "description": "1 (worst) – 5 (best) per dimension.",
          "properties": {
            "visual": { "type": "number" }, "typography": { "type": "number" }, "layout": { "type": "number" },
            "modernity": { "type": "number" }, "mobile": { "type": "number" }, "trust": { "type": "number" }, "conversion": { "type": "number" }
          }
        },
        "overall": { "type": "number" },
        "summary": { "type": ["string", "null"], "description": "One-line agent verdict on the site — reusable in dossiers/outreach." },
        "datedSignals": { "type": "array", "items": { "type": "string" } },
        "issues": {
          "type": "array",
          "items": { "type": "object", "properties": { "severity": { "enum": ["low", "medium", "high"] }, "area": { "type": "string" }, "note": { "type": "string" } } }
        },
        "opportunity": { "type": "number", "description": "0–1: how much a redesign would help." },
        "effortEstimate": { "enum": ["S", "M", "L"] }
      }
    }
  }
}
