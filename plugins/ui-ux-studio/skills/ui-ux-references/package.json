{
  "name": "ui-ux-references",
  "version": "0.1.0",
  "private": true,
  "description": "Re-usable, git-synced library of real-world UI references (screenshots + HTML + structured teardowns) for design inspiration. Companion to the ui-ux-pro-max skill.",
  "scripts": {
    "discover": "node research/discover.cjs",
    "extract": "node research/extract.cjs",
    "capture": "node research/extract.cjs",
    "index": "node scripts/build-index.cjs",
    "migrate": "node scripts/migrate-examples.cjs",
    "query": "python3 scripts/query.py",
    "setup": "bash bootstrap.sh"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "engines": {
    "node": ">=18"
  }
}
